# ============================================
# OmniAdmin 环境配置模板（复制为 .env.development 使用）
# 敏感值不入库；Logto Console 需登记 redirect URI / CORS
# ============================================

# API 基础地址（PostgREST）
VITE_API_URL=http://localhost:3100

# 是否携带凭证（cookies）
VITE_WITH_CREDENTIALS=false

# 应用版本
VITE_VERSION=1.0.0

# 系统名称
VITE_SYSTEM_NAME=OmniAdmin

# 权限模式【 frontend 前端模式（默认） / backend 后端模式（下一轮） 】
VITE_ACCESS_MODE=frontend

# ============================================
# Logto OIDC（全托管认证）
# ============================================
VITE_LOGTO_ENDPOINT=http://localhost:3001
VITE_LOGTO_APP_ID=
VITE_LOGTO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/auth/login
VITE_LOGTO_ORGANIZATION_ID=
